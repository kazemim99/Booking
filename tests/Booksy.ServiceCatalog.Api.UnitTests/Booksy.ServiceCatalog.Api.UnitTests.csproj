    <ProjectReference Include="..\..\src\BoundedContexts\ServiceCatalog\Booksy.ServiceCatalog.Api\Booksy.ServiceCatalog.Api.csproj" />
    <!-- ProviderBuilder for the search-specification tests. -->
    <ProjectReference Include="..\Booksy.Tests.Commons\Booksy.Tests.Commons.csproj" />
