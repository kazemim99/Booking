    <ProjectReference Include="..\..\src\Host\Booksy.Host\Booksy.Host.csproj" />
    <ProjectReference Include="..\..\src\BoundedContexts\ServiceCatalog\Booksy.ServiceCatalog.Api\Booksy.ServiceCatalog.Api.csproj" />
    <ProjectReference Include="..\..\src\BoundedContexts\ServiceCatalog\Booksy.ServiceCatalog.Infrastructure\Booksy.ServiceCatalog.Infrastructure.csproj" />
