<Project>

  <!--
    Applies to every project under tests/ and nothing else (there is no Directory.Build.props above
    this one, and MSBuild stops at the first it finds walking up).

    It exists for one reason: the flake sources in docs/TEST_ARCHITECTURE_AUDIT.md §5 are all APIs, and
    a rule that is an API can be enforced by the compiler instead of by review. See BannedSymbols.txt
    for what is banned and why each entry earns its place.

    Severity is warning, not error, on purpose for now: some existing violations are legitimate
    (a seeded Random in the booking-overlap stress test) and the rest — Random.Shared for unique phone
    numbers — are fixed by Phase 2's Ids helper, not by this file. Raise to error once Phase 2 lands
    (audit §9, Phase 1 task 15).
  -->

  <PropertyGroup>
    <!-- The analyzer ships as a build-time dependency and must not flow to anything referencing a
         test project (nothing does, but keep it honest). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
