<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground.
     The brand mark's 100x100 grid (branding/symbol-color.svg), scaled to 60dp and centred in the
     108dp adaptive-icon canvas so it stays inside the 66dp safe zone under any launcher mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="24">
        <path
            android:pathData="M50,13 L14,83 M50,13 L86,83"
            android:strokeColor="#FF3777C0"
            android:strokeWidth="8.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M32,48 L54,70 L82,25"
            android:strokeColor="#FF0AC075"
            android:strokeWidth="8.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
