{
  "mcpServers": {
    "asanrezerve-observability": {
      "command": "node",
      "args": ["/absolute/path/to/Booking/tools/observability-mcp/src/server.mjs"],
      "env": {
        "ASANREZERVE_API_URL": "https://back.nahalkmi.ir/api/v1",
