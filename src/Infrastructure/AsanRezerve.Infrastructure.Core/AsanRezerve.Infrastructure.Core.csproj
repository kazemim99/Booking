<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetCore.CAP" Version="8.0.0" />
    <PackageReference Include="DotNetCore.CAP.Dashboard" Version="8.0.0" />
    <PackageReference Include="DotNetCore.CAP.PostgreSql" Version="8.0.0" />
    <PackageReference Include="Savorboard.CAP.InMemoryMessageQueue" Version="8.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />
    <!-- L1 (in-process) + L2 (Redis) cache with stampede protection and tag invalidation (add-observability-and-caching). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\AsanRezerve.Core.Application\AsanRezerve.Core.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Persistence\Configurations\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the cache circuit-breaker counter to its unit tests. -->
    <InternalsVisibleTo Include="AsanRezerve.Infrastructure.Core.UnitTests" />
  </ItemGroup>

</Project>
