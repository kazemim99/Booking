<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<!-- Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"  Version="9.0.19" />

		<!-- Authorization -->
		<PackageReference Include="Microsoft.AspNetCore.Authorization"  Version="9.0.19" />

		<!-- Data Protection — 9.0.4 pulled System.Security.Cryptography.Xml 9.0.4 (HIGH,
		     GHSA-37gx-xxp4-5rgx). Bumped within the same major to the patched transitive. -->
		<PackageReference Include="Microsoft.AspNetCore.DataProtection"  Version="9.0.19" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions"  Version="9.0.19" />

		<!-- Caching (for rate limiting) -->
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.19" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />

		<!-- Logging -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions"  Version="9.0.19" />
	</ItemGroup>

</Project>
