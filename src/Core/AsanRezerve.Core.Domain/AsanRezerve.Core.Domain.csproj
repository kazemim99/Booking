<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904;CS1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Application\**" />
		<Compile Remove="Domain\**" />
		<Compile Remove="EventStore\**" />
		<Compile Remove="Infrastructure\**" />
		<EmbeddedResource Remove="Application\**" />
		<EmbeddedResource Remove="Domain\**" />
		<EmbeddedResource Remove="EventStore\**" />
		<EmbeddedResource Remove="Infrastructure\**" />
		<None Remove="Application\**" />
		<None Remove="Domain\**" />
		<None Remove="EventStore\**" />
		<None Remove="Infrastructure\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Domain\Utilities\Guard.cs" />
		<Compile Include="Domain\Entities\ProvinceCities.cs" />
	</ItemGroup>


	<ItemGroup>
		<!-- ASP.NET Core types (Microsoft.AspNetCore.Http/.Builder) come from the shared framework.
		     Was PackageReference Microsoft.AspNetCore.Http 2.3.0 + Http.Abstractions 2.3.0 — ASP.NET Core *2.x*
		     packages on a net9.0 project. Note this project also uses Microsoft.AspNetCore.Builder, which those
		     packages never provided, so it was already relying on the framework transitively.
		     (Architectural smell recorded separately: a Core.Domain project should not need ASP.NET Core at all.) -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="FluentValidation" Version="12.0.0" />
		<PackageReference Include="MediatR" Version="13.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.19" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.19" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
		<PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />

	</ItemGroup>

</Project>