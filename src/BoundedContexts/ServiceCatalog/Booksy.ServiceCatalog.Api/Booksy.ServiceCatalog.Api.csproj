<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8b6f7318-f753-4fe6-98c0-5745647b063e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <!-- This is a RETIRED per-service host. Booksy.Host references it only so the
         modular monolith can compose its controllers in-process; nothing publishes
         it standalone any more. Its appsettings*.json must therefore not flow into
         the referencing Host's publish output: publish flattens every project's
         content into one directory, where this project's appsettings.json,
         Booksy.UserManagement.API's and Booksy.Host's own all land on the same
         relative paths and fail the publish outright:
           error NETSDK1152: Found multiple publish output files with the same
           relative path: .../appsettings.json, .../appsettings.json, ...
         `dotnet build` never hit this (it keeps each project's output separate),
         which is why CI's build/test jobs passed for months while the Docker image
         build — the only step that runs `dotnet publish` — could never succeed.
         The composed Host owns runtime configuration; these files stay for local
         `dotnet run` of this project (CopyToOutputDirectory is untouched). -->
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
	<ItemGroup>

		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>


		<!-- ASP.NET Core -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="5.1.0" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.19" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />

		<!-- Swagger/OpenAPI -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />

		<!-- MediatR -->

		<!-- Logging -->
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />

		<!-- Health Checks -->
		<!-- AspNetCore.HealthChecks.SqlServer removed: this system runs on PostgreSQL and nothing ever
		     registered a SQL Server health check. It pulled Microsoft.Data.SqlClient 5.1.1 (HIGH), which in
		     turn pulled System.Formats.Asn1 5.0.0 (HIGH) and Azure.Identity 1.7.0 (moderate). -->
		<PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
		<PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.0" />

		<!-- Rate Limiting -->
		<PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
		<PackageReference Include="AspNetCoreRateLimit.Redis" Version="2.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />

		<!-- Monitoring -->
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
		<PackageReference Include="Sentry.AspNetCore" Version="4.0.0" />

		<!-- Docker -->
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Infrastructure\Booksy.API\Booksy.API.csproj" />
    <ProjectReference Include="..\..\..\Infrastructure\Booksy.Infrastructure.Security\Booksy.Infrastructure.Security.csproj" />
    <ProjectReference Include="..\Booksy.ServiceCatalog.Application\Booksy.ServiceCatalog.Application.csproj" />
    <ProjectReference Include="..\Booksy.ServiceCatalog.Domain\Booksy.ServiceCatalog.Domain.csproj" />
    <ProjectReference Include="..\Booksy.ServiceCatalog.Infrastructure\Booksy.ServiceCatalog.Infrastructure.csproj" />
  </ItemGroup>

</Project>
