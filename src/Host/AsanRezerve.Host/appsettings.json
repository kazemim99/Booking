{
  "Logging": {
    "_comment": "The level gate for every log event (add-observability-and-caching D1). Serilog only receives what passes here. Admins can override any category at runtime from the admin panel (Logs > Log levels).",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning",
      "System.Net.Http": "Warning",
      "DotNetCore.CAP": "Warning",
      "Npgsql": "Warning",
      "AsanRezerve": "Information"
    }
  },
  "Observability": {
    "Logging": {
      "Console": { "Enabled": true },
      "File": { "Enabled": true, "Path": "logs/asanrezerve-host-.clef", "FileSizeLimitMb": 50, "RetainedFileCount": 7 },
      "Seq": { "ServerUrl": "", "ApiKey": "" },
      "SlowRequestThresholdMs": 1000
    }
  },
