{
  "_comment": "Loaded when ASPNETCORE_ENVIRONMENT=Testing. No test boots this per-service host any more — tests/AsanRezerve.Host.IntegrationTests/UserManagement retargeted to AsanRezerve.Host in docs/TEST_ARCHITECTURE_AUDIT.md Phase 2 slice 3. Kept for any future standalone run of this API; still quiet and unseeded under test.",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "DotNetCore.CAP": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },

  "Database": {
    "SeedOnStartup": false
  },
  "DatabaseSettings": {
    "EnableSensitiveDataLogging": false
  },

  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "localhost:6379,abortConnect=false"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "EventBus": {
    "Provider": "InMemory"
  },
  "RateLimiting": {
    "Enabled": false
  },
  "Otp": {
    "Protection": {
      "MaxSendsPerWindow": 1000,
      "ResendCooldown": "00:00:00"
    }
  }
}
